  "description": "A minimalist focus timer — web version for Vercel",
  "author": "example.com",
  "homepage": "https://github.com/anomalyco/opencode",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
